<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerComposeProjectPath>..\docker-compose\docker-compose.dcproj</DockerComposeProjectPath>
		<UserSecretsId>poc-docker</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="MudBlazor" Version="9.*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Common\Poc.Common.Web\Poc.Common.Web.csproj" />
		<ProjectReference Include="..\..\Common\Poc.Common\Poc.Common.csproj" />
		<ProjectReference Include="..\Poc.Ef.Application\Poc.Ef.Application.csproj" />
		<ProjectReference Include="..\Poc.Ef.Infrastructure\Poc.Ef.Infrastructure.csproj" />
		<ProjectReference Include="..\Poc.Ef.Persistence\Poc.Ef.Persistence.csproj" />
	</ItemGroup>
</Project>