<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<DockerComposeProjectPath>..\docker-compose\docker-compose.dcproj</DockerComposeProjectPath>
		<UserSecretsId>poc-docker</UserSecretsId>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
		<PackageReference Include="MudBlazor" Version="9.*" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Common\Poc.Common.Data\Poc.Common.Data.csproj" />
	  <ProjectReference Include="..\..\Common\Poc.Common.Web\Poc.Common.Web.csproj" />
	  <ProjectReference Include="..\..\Common\Poc.Common\Poc.Common.csproj" />
	</ItemGroup>
</Project>