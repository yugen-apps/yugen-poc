<MudDialog>
	<DialogContent>
		<MudText>@ContentText</MudText>
	</DialogContent>
	<DialogActions>
		<MudButton OnClick="Cancel"
				   Variant="Variant.Filled">
			Cancel
		</MudButton>
		<MudButton Color="@Color"
				   OnClick="Submit"
				   Variant="Variant.Filled">
			@ButtonText
		</MudButton>
	</DialogActions>
</MudDialog>