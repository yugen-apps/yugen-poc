@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthenticationStateProvider

<AuthorizeView>
    <Authorized>
        <form action="/authentication/logout" method="post">
            <AntiforgeryToken />
            <MudButton ButtonType="ButtonType.Submit">Entra Logout</MudButton>
        </form>
        <form action="/identity/logout" method="post">
            <AntiforgeryToken />
            <MudButton ButtonType="ButtonType.Submit">Google Logout</MudButton>
        </form>
    </Authorized>
    <NotAuthorized>
        <MudButton Href="/authentication/login?returnUrl=user-claims">Entra Login</MudButton>

        <MudButton Href="/identity/login">Google Login</MudButton>
    </NotAuthorized>
</AuthorizeView>